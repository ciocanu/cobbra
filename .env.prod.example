# ══════════════════════════════════════════════════════════════════════════════
# Cobbra — Production Environment Variables
# Copy this file to .env.prod and fill in real values.
# NEVER commit .env.prod to version control.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ══════════════════════════════════════════════════════════════════════════════

# ── Domain ────────────────────────────────────────────────────────────────────
# Your public domain — used in nginx server_name, SSL cert path, and CORS.
DOMAIN=yourdomain.com

# ── Application ───────────────────────────────────────────────────────────────
# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-char-random-value

# Must be true in production (ensures cookies are only sent over HTTPS)
COOKIE_SECURE=true

# Comma-separated allowed CORS origins — usually just your domain
CORS_ORIGINS=https://yourdomain.com

# The first account registered with this username gets admin panel access
ADMIN_USERNAME=your_admin_username

# Base URL included in email links (no trailing slash)
APP_URL=https://yourdomain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials for the database created by the postgres container.
# DATABASE_URL is assembled automatically in docker-compose.prod.yml.
POSTGRES_USER=cobbra
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=cobbra

# ── Email — Gmail App Password ────────────────────────────────────────────────
# 1. Enable 2FA on your Google account
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an app password (16 characters, no spaces)
# Leave all SMTP_* blank to disable email features (verification, lifetime offer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=Cobbra <your_gmail@gmail.com>

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_live_... keys in production (sk_test_... for staging)
# dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# dashboard.stripe.com/webhooks → Add endpoint → Signing secret
# Endpoint URL: https://yourdomain.com/api/payments/webhook
# Events: checkout.session.completed, invoice.payment_succeeded, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# dashboard.stripe.com/products → create 3 products → copy price_ IDs
STRIPE_PRICE_PRO=price_...       # €7 / month recurring
STRIPE_PRICE_ANNUAL=price_...    # €49 / year recurring
STRIPE_PRICE_LIFETIME=price_...  # €129 one-time

# ── Anthropic ─────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
# Enables: AI ride analysis, AI training plans, note moderation
ANTHROPIC_API_KEY=sk-ant-...
